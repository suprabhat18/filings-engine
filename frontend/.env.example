# Google OAuth: the same Web client the backend checks tokens against
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth: the site's URL and a random secret (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Backend URL, used only on the server (the browser never calls it directly)
BACKEND_URL=http://localhost:8000

# Free "Try it now" question on the homepage: the same value as the backend's
# PROXY_SECRET (openssl rand -hex 32). Leave empty to switch free questions off.
PROXY_SECRET=

# Optional: Cloudflare Turnstile site key (free bot check for free questions)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: your LinkedIn profile URL, shown in the footer
NEXT_PUBLIC_LINKEDIN_URL=
