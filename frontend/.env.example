# Google OAuth: the same Web client the backend checks tokens against
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth: the site's URL and a random secret (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Backend URL, used only on the server (the browser never calls it directly)
BACKEND_URL=http://localhost:8000
