GCP_PROJECT_ID=your-gcp-project-id

# Vertex AI Search (must match ingestion/.env)
GCP_LOCATION=global
VERTEX_SEARCH_ENGINE_ID=sec-filings-search
RESULTS_PER_QUERY=8

# Gemini on Vertex AI
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=global

# Google OAuth: the Web client ID from APIs & Services > Credentials
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Optional: only these emails may sign in (comma-separated). Empty = any Google account.
ALLOWED_EMAILS=

# Cost protection
RATE_LIMIT_PER_MINUTE=10
DAILY_USER_QUOTA=50
DAILY_GLOBAL_QUOTA=1000

CORS_ORIGINS=http://localhost:3000
